# 狮子英语 API - 生产环境优化版 Dockerfile
# 采用多阶段构建减少镜像体积

# 阶段 1: 构建环境
FROM python:3.11-slim as builder

WORKDIR /app

# 安装系统编译工具
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    make \
    libmariadb-dev \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

# 复制 requirements.txt 并安装依赖到虚拟环境
COPY requirements.txt .
RUN pip install --user --no-cache-dir -r requirements.txt -i https://pypi.tuna.tsinghua.edu.cn/simple

# 阶段 2: 运行环境
FROM python:3.11-slim

WORKDIR /app

# 安装运行时所需的系统库（不包含编译工具）
RUN apt-get update && apt-get install -y \
    curl \
    libmariadb3 \
    && rm -rf /var/lib/apt/lists/*

# 从构建阶段复制 Python 依赖
COPY --from=builder /root/.local /root/.local

# 设置环境变量
ENV PATH=/root/.local/bin:$PATH \
    PYTHONPATH=/app:$PYTHONPATH \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

# 复制项目代码
COPY . .

# 创建必要目录并设置权限
RUN mkdir -p logs uploads data && \
    chmod -R 755 logs uploads data

# 非 root 用户运行应用（提高安全性）
RUN useradd -m -u 1000 appuser && \
    chown -R appuser:appuser /app
USER appuser

# 暴露端口
EXPOSE 5000

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:5000/health || exit 1

# 使用 gunicorn 作为生产 WSGI 服务器（比 Flask 开发服务器更稳定）
# 注意：需要在 requirements.txt 中添加 gunicorn
CMD ["gunicorn", "--bind", "0.0.0.0:5000", "--workers", "4", "--threads", "2", "--worker-class", "gthread", "--timeout", "60", "--access-logfile", "-", "--error-logfile", "-", "app:app"]
