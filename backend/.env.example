# Windows 本地开发默认配置；复制为 .env 后使用。
FLASK_ENV=development
FLASK_DEBUG=1
HOST=0.0.0.0
PORT=5000

# 本地无需安装 MySQL，首次启动会在 instance/ 下创建 SQLite 文件。
SQLALCHEMY_DATABASE_URI=sqlite:///xuebadict_local.db
AUTO_CREATE_DB=true
SECRET_KEY=local-only-change-me
JWT_SECRET_KEY=local-only-jwt-change-me

# 默认使用模拟 AI，千问/DeepSeek 的 API 路由可先联调，再切换真实密钥。
AI_MODE=simulation
AI_SIMULATION=true
AI_CLIENT=http
QWEN_MODEL=qwen-plus
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5000,http://127.0.0.1:5000
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
UPLOAD_FOLDER=uploads
